<!--          </figure> -->
        </sidebyside>
      </statement>
      <hint/>
      <answer>
        <sidebyside width="50%" valign="middle">
<!--          <table xml:id="T-tandem-act-sphere-V-t">
            <title>Data for how volume and time change together.</title> -->
            <tabular>
              <row bottom="minor">
                <cell>
                  <m>t</m>
                </cell>
                <cell>
                  <m>V</m>
                </cell>
              </row>
              <row>
                <cell>
                  <m>0</m>
                </cell>
                <cell><m>113.1</m></cell>
              </row>
              <row>
                <cell>
                  <m>20</m>
                </cell>
                <cell><m>89.1</m></cell>
              </row>
              <row>
                <cell>
                  <m>40</m>
                </cell>
                <cell><m>65.1</m></cell>
              </row>
              <row>
                <cell>
                  <m>60</m>
                </cell>
