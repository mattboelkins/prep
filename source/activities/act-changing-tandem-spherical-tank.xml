          <figure xml:id="F-tandem-act-sphere-V-t">
            <caption>A plot of how volume and time change in tandem in a draining spherical tank.</caption> -->
            <image width="45%">
                <prefigure xmlns="https://prefigure.org" label="prefigure-tandem-sphere-volumegraph-ans">
                    <diagram dimensions="(300,300)" margins="5">
                      <definition>f(x)=36*pi-1.2*x</definition>
                      <coordinates bbox="(-20,-20,120,120)">
                        <grid-axes xlabel="t" ylabel="V \text{(cubic feet)}" hticks="(-20,20,100)" vticks="(-20,20,100)" hlabels="(20,40,100)" vlabels="(20,40,100)" spacings="((-20,10,120),(-20,10,120))"/>
